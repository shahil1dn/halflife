# Keep editors from fighting each other. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown, so leave them alone.
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
